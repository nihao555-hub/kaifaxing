# AI (OpenAI-compatible Chat Completions endpoint)
AI_BASE_URL=https://grsaiapi.com
AI_API_KEY=
AI_MODEL=gpt-5.6-sol

# 163 SMTP / IMAP
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.163.com
IMAP_PORT=993
SENDER_NAME=Alice | OutreachAI

# Google Programmable Search Engine (preferred)
SEARCH_ENGINE=google
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Optional fallback only when SEARCH_ENGINE=auto or serper
SERPER_API_KEY=

# Optional registry sources
SAM_API_KEY=
COMPANIES_HOUSE_API_KEY=
OPENCORPORATES_API_KEY=

# Durable private S3-compatible runtime backup (AWS S3 / Cloudflare R2 / MinIO)
DATA_S3_BUCKET=
DATA_S3_KEY=outreach-ai/db.json.gz
DATA_S3_REGION=auto
DATA_S3_ENDPOINT=
DATA_S3_ACCESS_KEY_ID=
DATA_S3_SECRET_ACCESS_KEY=
DATA_BACKUP_DEBOUNCE_MS=60000

# Cloud database for the full RFQ library (~160k). MongoDB Atlas free M0 is enough.
# Create a cluster, allow 0.0.0.0/0, then paste the connection string.
MONGODB_URI=
MONGODB_DB=outreachai
